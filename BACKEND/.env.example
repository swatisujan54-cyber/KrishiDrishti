# ============================================================
# KrishiDrishti Backend — Environment Variables (TEMPLATE)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Application ---
APP_NAME=KrishiDrishti API
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api

# --- Database ---
# SQLite for development. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/krishidrishti
DATABASE_URL=sqlite:///./data/krishidrishti.db

# --- Security ---
# Generate a strong secret key, e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-secret-string
ALGORITHM=HS256
# How long an access token stays valid (minutes). 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Use the actual frontend URL(s) in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Image Upload ---
# Directory where uploaded images are stored.
UPLOAD_DIR=data/uploads
# Maximum upload size in bytes. 10485760 = 10 MB.
MAX_IMAGE_SIZE_BYTES=10485760
# Allowed image formats (Pillow format names), comma-separated.
ALLOWED_IMAGE_FORMATS=JPEG,PNG

# --- Prediction / AI ---
# Path to a trained model file. Leave blank to use the mock predictor.
# MODEL_PATH=ml/model/crop_disease_model.h5
MODEL_PATH=
# Path to the label-mapping JSON (model output index -> disease name).
LABELS_PATH=ml/labels.json
# Input image size the model/preprocessing expects, as WIDTH,HEIGHT.
IMAGE_SIZE=224,224
# Confidence below this fraction is reported as "uncertain".
PREDICTION_CONFIDENCE_THRESHOLD=0.5
# How many top predictions to return.
PREDICTION_TOP_K=3

# --- Languages ---
DEFAULT_LANGUAGE=en
# Comma-separated list of supported language codes.
SUPPORTED_LANGUAGES=en,hi

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
