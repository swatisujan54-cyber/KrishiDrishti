# =============================================================
# KrishiDrishti — Root .gitignore
# This file covers the entire project (BACKEND + FRON).
# Each subfolder also has its own .gitignore for extra detail.
# =============================================================

# ----- Operating system files --------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Editor and IDE ----------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================
# BACKEND — Python / FastAPI
# =============================================================

# Virtual environment — never commit this (it's hundreds of MB)
BACKEND/venv/
BACKEND/.venv/
BACKEND/env/

# Python compiled files — generated automatically, not source code
BACKEND/**/__pycache__/
BACKEND/**/*.py[cod]
BACKEND/**/*$py.class
BACKEND/**/*.so

# Environment file — contains your SECRET_KEY and other secrets
# The .env.example file (with placeholder values) IS allowed
BACKEND/.env
BACKEND/*.env.local

# Database — contains real user data, not source code
BACKEND/data/*.db
BACKEND/data/*.db-journal
BACKEND/data/*.sqlite
BACKEND/data/*.sqlite3

# Uploaded images — user-submitted photos, not source code
BACKEND/data/uploads/*
!BACKEND/data/uploads/.gitkeep

# Trained AI model weights — can be very large files
BACKEND/ml/model/*
!BACKEND/ml/model/.gitkeep

# Test and coverage artifacts
BACKEND/.pytest_cache/
BACKEND/htmlcov/
BACKEND/.coverage
BACKEND/.coverage.*

# Build artifacts
BACKEND/dist/
BACKEND/build/
BACKEND/*.egg-info/

# Stray image files in source folders (test uploads left behind)
BACKEND/app/*.png
BACKEND/app/*.jpg
BACKEND/app/*.jpeg

# =============================================================
# FRON — React / Vite / TypeScript frontend
# =============================================================

# Node modules — installed from package.json, never committed
# (This folder can be over 300 MB)
FRON/node_modules/

# Production build output — generated by "npm run build"
# Anyone cloning can rebuild this with one command
FRON/dist/

# Environment file — for any frontend API keys or configuration
FRON/.env
FRON/.env.local
FRON/.env.*.local

# Vite and TypeScript cache
FRON/.vite/

# =============================================================
# What IS included (safe to upload)
# =============================================================
# BACKEND source code (app/, ml/, tests/)
# BACKEND requirements.txt, pytest.ini, README.md
# BACKEND .env.example (placeholder values only — safe)
# BACKEND ml/labels.json, ml/preprocessing.py
# FRON source code (src/)
# FRON package.json, package-lock.json
# FRON vite.config.ts, tailwind.config.js, tsconfig.json
# FRON index.html, postcss.config.js

# =============================================================
# Extra exclusions added 2026-11-01
# =============================================================

# Root-level .env files (any variant) — never commit secrets
.env
.env.*
# Allow the example template (contains placeholder values only)
!.env.example

# Temporary git identity files created during setup
git_email.txt
git_name.txt
